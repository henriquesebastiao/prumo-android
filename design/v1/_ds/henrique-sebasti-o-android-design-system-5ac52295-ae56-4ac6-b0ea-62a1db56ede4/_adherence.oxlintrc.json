{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/chips/**",
              "components/containers/**",
              "components/feedback/**",
              "components/inputs/**",
              "components/layout/**",
              "components/lists/**",
              "components/media/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/theme/**",
              "ui_kits/media/**",
              "ui_kits/netrik/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Google Sans Flex|Roboto Flex|JetBrains Mono|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Google Sans Flex, Roboto Flex, JetBrains Mono, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTheme'] > JSXAttribute > JSXIdentifier[name!=/^(?:seed|variant|mode|amoled|dynamicColor|motion|children|style|className|key|ref|className|style|children)$/]",
        "message": "<AppTheme> doesn't accept that prop. Declared props: seed, variant, mode, amoled, dynamicColor, motion, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTheme'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tonalSpot|vibrant|expressive|content|fidelity|neutral)$/]",
        "message": "<AppTheme> variant must be one of 'tonalSpot' | 'vibrant' | 'expressive' | 'content' | 'fidelity' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTheme'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark|system)$/]",
        "message": "<AppTheme> mode must be one of 'light' | 'dark' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppTheme'] > JSXAttribute[name.name='motion'] > Literal[value!=/^(?:expressive|standard)$/]",
        "message": "<AppTheme> motion must be one of 'expressive' | 'standard'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Artwork'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|width|height|shape|radius|rotate|tone|color|contentColor|icon|style|key|ref|className|style|children)$/]",
        "message": "<Artwork> doesn't accept that prop. Declared props: src, alt, size, width, height, shape, radius, rotate, tone, color, contentColor, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Artwork'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|secondary|tertiary)$/]",
        "message": "<Artwork> tone must be one of 'neutral' | 'primary' | 'secondary' | 'tertiary'."
